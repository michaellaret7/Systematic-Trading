# Copy to .env and fill in. .env is git-ignored.

# --- Alpaca (broker + live/backtest price feed) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
# true = paper trading (default/safe). Set to false ONLY for real-money live trading.
ALPACA_PAPER=true

# --- Financial Modeling Prep (fundamentals / macro enrichment) ---
FMP_API_KEY=

# --- AWS (S3 data repository + DynamoDB trade ledger) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region hosting the DynamoDB trade-ledger table. Defaults to us-east-1 if unset.
AWS_DEFAULT_REGION=us-east-1
# S3 bucket for the data repository.
S3_BUCKET=

# Local copy of the read-only snapshot the agent code sandbox mounts. Only set
# this outside the cloud: a strategy droplet stages the snapshot at the default
# path. Populate it with
#   uv run python -m systematic_trading.agents.shared_tools.sandbox.sync
SANDBOX_DATA_DIR=
# CloudWatch Logs group for real-time log streaming. Leave BLANK locally (logs
# stay stdout-only); the cloud bootstrap sets it so live runs stream to
# CloudWatch. Set it locally only if you want a local run to stream too.
# Tail: aws logs tail systematic-trading --follow
CLOUDWATCH_LOG_GROUP=
# Stream name inside that group. Defaults to "local" when unset; the cloud
# bootstrap sets a per-machine name.
CLOUDWATCH_LOG_STREAM=

# --- OpenRouter (LLM gateway — every agent runs provider="openrouter") ---
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# --- Parallel (web search / extract tools used by the research subagents) ---
PARALLEL_API_KEY=

# --- Langfuse (LLM tracing / observability) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# --- DigitalOcean (droplet launcher: `uv run live --cloud`, scripts/launch_ideas_droplet.py) ---
# Required to launch a droplet — the machine also uses it to delete itself, so a
# launch without it is refused rather than left billing forever.
DIGITALOCEAN_TOKEN=

# --- RunPod (alternate pod launcher: systematic_trading/cloud/runpod.py) ---
RUNPOD_API_KEY=
# GitHub fine-grained PAT with read access to this repo, so the machine can clone it.
GITHUB_TOKEN=

# --- Lumibot runtime ---
# Disable the background telemetry emitter (stops the LUMIBOT_TELEMETRY JSON log lines).
LUMIBOT_TELEMETRY=false
# Lumibot re-applies this on every get_logger() call, so it is the only durable level knob.
# INFO keeps fill events ("Order was filled: ..."); the unified logger reformats them.
# (Ignored in backtests, where Lumibot pins itself to ERROR.)
LUMIBOT_LOG_LEVEL=INFO
